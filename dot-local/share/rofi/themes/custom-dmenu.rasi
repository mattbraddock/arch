/**
 * ROFI Color theme
 * User: Qball
 * Copyright: Dave Davenport
 */

* {
    background-color:      rgba(0, 0, 0, 0.3);
    border-color:          White;
    text-color:           White;
    font:            "IBM Plex Mono 10";
}
window {
    anchor:     north;
    location:   north;
    width:      100%;
    padding:    4px;
    children:   [ horibox ];
}
horibox {
    orientation: horizontal;
    children:   [ entry, message, listview ];
}
listview {
    layout:     horizontal;
    lines:      100;
}
entry {
    expand:     false;
    width:      10em;
}
message{
    expand: true;
}
element {
    padding: 0px 2px;
}
element selected {
    background-color: rgba(80, 80, 80, 0.5);
}

element-text, element-icon {
  background-color: inherit;
  text-color: inherit;
}
