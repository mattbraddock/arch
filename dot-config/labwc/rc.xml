<?xml version="1.0" ?>
<labwc_config>
    <desktops number="4" />
    <windowSwitcher preview="yes" outlines="yes">
      <osd show="yes" style="classic" output="all" thumbnailLabelFormat="%T" />
      <fields>
        <field content="icon" width="5%" />
        <field content="desktop_entry_name" width="30%" />
        <field content="title" width="65%" />
      </fields>
    </windowSwitcher>
    <focus>
        <raiseOnFocus>yes</raiseOnFocus>
    </focus>
    <keyboard>
        <keybind key="W-1">
          <action name="GoToDesktop">
            <to>1</to>
          </action>
        </keybind>
        <keybind key="W-2">
          <action name="GoToDesktop">
            <to>2</to>
          </action>
        </keybind>
        <keybind key="W-3">
          <action name="GoToDesktop">
            <to>3</to>
          </action>
        </keybind>
        <keybind key="W-4">
          <action name="GoToDesktop">
            <to>4</to>
          </action>
        </keybind>
        <keybind key="W-S-1">
          <action name="SendToDesktop">
            <to>1</to>
            <wrap>no</wrap>
          </action>
        </keybind>
        <keybind key="W-S-2">
          <action name="SendToDesktop">
            <to>2</to>
            <wrap>no</wrap>
          </action>
        </keybind>
        <keybind key="W-S-3">
          <action name="SendToDesktop">
            <to>3</to>
            <wrap>no</wrap>
          </action>
        </keybind>
        <keybind key="W-S-4">
          <action name="SendToDesktop">
            <to>4</to>
            <wrap>no</wrap>
          </action>
        </keybind>
        <keybind key="W-S-Left">
          <action name="SendToDesktop">
            <to>left</to>
            <wrap>no</wrap>
          </action>
        </keybind>
        <keybind key="W-S-Right">
          <action name="SendToDesktop">
            <to>right</to>
            <wrap>no</wrap>
          </action>
        </keybind>
        <keybind key="W-Right">
          <action name="SnapToEdge" direction="right" />
        </keybind>
        <keybind key="W-Left">
          <action name="SnapToEdge" direction="left" />
        </keybind>
        <keybind key="W-Up">
          <action name="SnapToEdge" direction="up" />
        </keybind>
        <keybind key="W-Down">
          <action name="SnapToEdge" direction="down" />
        </keybind>
        <keybind key="W-S-Up">
          <action name="ToggleMaximize" direction="both" />
        </keybind>
        <keybind key="W-S-Down">
          <action name="Iconify" />
        </keybind>
        <keybind key="W-d">
          <action name="ToggleShowDesktop" />
        </keybind>
        <keybind key="A-F4">
          <action name="Close"/>
        </keybind>
        <keybind key="W-q">
          <action name="Close"/>
        </keybind>
        <keybind key="A-space">
          <action name="ShowMenu">
            <menu>client-menu</menu>
          </action>
        </keybind>
        <keybind key="A-Tab">
          <action name="NextWindow">
            <finalactions>
              <action name="Focus"/>
              <action name="Raise"/>
              <action name="Unshade"/>
            </finalactions>
          </action>
        </keybind>
        <keybind key="A-S-Tab">
          <action name="PreviousWindow">
            <finalactions>
              <action name="Focus"/>
              <action name="Raise"/>
              <action name="Unshade"/>
            </finalactions>
          </action>
        </keybind>
        <keybind key="W-t">
            <action name="Execute" command="foot" />
        </keybind>
        <keybind key="W-e">
            <action name="Execute" command="mousepad" />
        </keybind>        
        <keybind key="W-f">
            <action name="Execute" command="thunar" />
        </keybind>
        <keybind key="W-w">
            <action name="Execute" command="firefox" />
        </keybind>
        <keybind key="W-l">
            <action name="Execute" command="swaylock" />
        </keybind>
        <keybind key="W-Return">
            <action name="Execute" command="rofi -show drun" />
        </keybind>
        <keybind key="W-Escape">
            <action name="Execute" command="rofi -show p -modi p:rofi-power-menu" />
        </keybind>
        <keybind key="W-c">
            <action name="Execute" command="rofi -show calc -modi calc -no-show-match -no-sort -no-history -lines 0" />
        </keybind>
        <keybind key="Print">
            <action name="Execute" command='grim -g "$(slurp)" - | wl-copy' />
        </keybind>
        <keybind key="S-Print">
            <action name="Execute" command='grim -g "$(slurp)" $(xdg-user-dir PICTURES)/Screenshots/$(date + "%s_grim.png")' />
        </keybind>
        <keybind key="XF86AudioMute">
            <action name="Execute" command="pamixer -t" />
        </keybind>
        <keybind key="XF86AudioRaiseVolume">
            <action name="Execute" command="pamixer -u" />
            <action name="Execute" command="pamixer -i 5" />
        </keybind>
        <keybind key="XF86AudioLowerVolume">
            <action name="Execute" command="pamixer -u" />
            <action name="Execute" command="pamixer -d 5" />
        </keybind>
        <keybind key="XF86MonBrightnessUp">
            <action name="Execute" command="brightnessctl -q set +100" />
        </keybind>
        <keybind key="XF86MonBrightnessDown">
            <action name="Execute" command="brightnessctl -q set 100-" />
        </keybind>
    </keyboard>
</labwc_config>