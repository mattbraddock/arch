{
    "layer": "top",
    "height": 34,
    "position": "bottom",
    "modules-left": [],
    "modules-center": ["wlr/taskbar"],
    "modules-right": ["battery", "backlight", "pulseaudio", "network", "clock"],
    "expand-center": true,
    "fixed-center": false,
    "reload_style_on_change": true,
    "backlight": {
        "format": "{percent}% {icon}",
        "format-icons": ["", ""],
        "on-click": "brightnessctl -q set +100",
        "on-click-right": "brightnessctl -q set 100-"
    },
    "battery": {
        "format": "{capacity}% {icon}",
        "format-icons": ["", "", "", "", ""]
    },
    "clock": {
        "interval": 1,
        "format": "{:%a %d %b  %r}",
        "on-click": "gsimplecal"
    },
    "network": {
        "interface": "wlp2s0",
        "format": "{ifname}",
        "format-wifi": "{essid} ({signalStrength}%)",
        "format-disconnected": "No Wi-Fi",
        "tooltip-format": "{ifname}",
        "on-click": "nm-connection-editor",
        "max-length": 50
    },
    "pulseaudio": {
        "format": "{volume}% {icon}",
        "format-icons": {
            "alsa_output.pci-0000_00_1f.3.analog-stereo": "",
            "alsa_output.pci-0000_00_1f.3.analog-stereo-muted": "",
            "headphone": "",
            "default": ""
        },
        "on-click": "pavucontrol-qt"
    },
    "wlr/taskbar": {
        "format": "{name}",
        "expand": true,
        "homogeneous": true,
        "justify": "center",
        "on-click": "minimize-raise"
    }
}